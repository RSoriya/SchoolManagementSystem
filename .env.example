# Django
DJANGO_SETTINGS_MODULE=config.settings.development
SECRET_KEY=replace-this-with-a-long-random-secret
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=

# Production example
# DJANGO_SETTINGS_MODULE=config.settings.production
# ALLOWED_HOSTS=school.example.com
# CSRF_TRUSTED_ORIGINS=https://school.example.com
# SECURE_SSL_REDIRECT=true
# SECURE_HSTS_SECONDS=3600

# Database
# Use "sqlite" for a quick local start or "postgresql" for PostgreSQL.
DB_ENGINE=postgresql
DB_NAME=school_manager
DB_USER=postgres
DB_PASSWORD=change-me
DB_HOST=127.0.0.1
DB_PORT=5432
DB_CONN_MAX_AGE=60

# School defaults
SCHOOL_NAME=School Management System
SCHOOL_TIME_ZONE=Asia/Phnom_Penh

# Telegram (Settings page overrides these env fallbacks)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Backups (daily, keep 30 days). Restore only from CLI after verify.
BACKUP_DIR=
BACKUP_KEEP_DAYS=30
LOGIN_FAILURE_LIMIT=5
LOGIN_FAILURE_WINDOW=900
GUNICORN_WORKERS=3
